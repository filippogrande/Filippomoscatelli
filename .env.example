# Esempio di file .env per configurazioni (NON commitare in Git)
# Copia questo file come .env e personalizza i valori
#
# Il compose di produzione sta fuori dal repo, in
# /mnt/applicazioni/yml/docker/filippomoscatelli: qui restano solo i nomi delle
# variabili usate dal compose locale (docker-compose.yml).

# Docker Configuration
IMAGE_NAME=filippogrande/cv-website
IMAGE_TAG=latest
CONTAINER_NAME=filippomoscatelli-cv-local
LOCAL_PORT=8080

# Dominio pubblico (documentazione, nessun valore usato dal compose)
DOMAIN=filippomoscatelli.com
